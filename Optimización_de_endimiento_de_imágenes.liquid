{% liquid
  assign block_settings = block.settings
  assign ratio = 1


  case block_settings.image_ratio
    when 'landscape'
      assign ratio = '16 / 9'
    when 'portrait'
      assign ratio = '4 / 5'
    when 'adapt'
      assign ratio = block_settings.image.aspect_ratio
  endcase


  if ratio == 0 or ratio == null
    assign ratio = 1
  endif


  assign ratio_mobile = ratio


  if block_settings.use_mobile_ratio
    case block_settings.image_ratio_mobile
      when 'landscape'
        assign ratio_mobile = '16 / 9'
      when 'portrait'
        assign ratio_mobile = '4 / 5'
      when 'square'
        assign ratio_mobile = '1 / 1'
      when 'adapt'
        assign ratio_mobile = block_settings.image.aspect_ratio
    endcase
  endif


  if ratio_mobile == 0 or ratio_mobile == null
    assign ratio_mobile = ratio
  endif
%}


{% capture class %}
  image-block image-block--{{ block.id }} image-block--height-{{ block_settings.height }} spacing-style size-style
{% endcapture %}


{% capture style %}
  --ratio: {{ ratio }};
  --ratio-mobile: {{ ratio_mobile }};
  {% render 'size-style', settings: block_settings %}
  {% render 'spacing-style', settings: block_settings %}
{% endcapture %}


{% capture image_border_style %}
  --ratio: {{ ratio }};
  --ratio-mobile: {{ ratio_mobile }};
  {% render 'border-override', settings: block_settings %}
{% endcapture %}


{% liquid
  assign media_width_desktop = '100vw'
  assign media_width_mobile = '100vw'


  if block_settings.width == 'custom'
    assign desktop_percent = block_settings.custom_width | plus: 0
    assign media_width_desktop = desktop_percent | append: 'vw'
  endif


  if block_settings.width_mobile == 'custom'
    assign mobile_percent = block_settings.custom_width_mobile | plus: 0
    assign media_width_mobile = mobile_percent | append: 'vw'
  endif


  assign sizes = '(min-width: 990px) ' | append: media_width_desktop | append: ', (min-width: 750px) ' | append: media_width_desktop | append: ', ' | append: media_width_mobile
  assign widths = '375, 550, 750, 1100, 1500, 1800, 2200, 3000, 3840'
%}


{% liquid
  assign loading_attr = 'lazy'
  assign fetchpriority_attr = 'auto'
  assign decoding_attr = 'async'


  if block_settings.lazy == false
    assign loading_attr = 'eager'
    assign fetchpriority_attr = 'high'
  endif
%}


{% capture image %}
{%- if block_settings.image -%}
  {{
    block_settings.image
    | image_url: width: 3840
    | image_tag:
      width: block_settings.image.width,
      height: block_settings.image.height,
      class: 'image-block__image border-style',
      style: image_border_style,
      sizes: sizes,
      widths: widths,
      loading: loading_attr,
      fetchpriority: fetchpriority_attr,
      decoding: decoding_attr,
      alt: block_settings.image.alt | default: '' | escape
  }}
{%- else -%}
  <div class="placeholder-image border-style size-style" style="{{ image_border_style }}">
    {{ 'detailed-apparel-1' | placeholder_svg_tag: 'hero__image' }}
  </div>
{%- endif -%}


{% endcapture %}


{% if block_settings.link == blank %}
  <div
    class="{{ class }}"
    style="{{ style }}"
    {{ block.shopify_attributes }}
  >
    {{ image }}
  </div>
{% else %}
  <a
    href="{{ block_settings.link }}"
    class="{{ class }}"
    style="{{ style }}"
    {{ block.shopify_attributes }}
  >
    {{ image }}
  </a>
{% endif %}


{% stylesheet %}
      .placeholder-image {
        position: relative;
        aspect-ratio: var(--ratio);
        overflow: hidden;
      }


      .placeholder-image img {
        width: 100%;
        height: 100%;
        aspect-ratio: var(--ratio);
        object-fit: cover;
      }


      .image-block {
        display: flex;
        justify-content: var(--horizontal-alignment, 'inline-start');
      }


      .image-block--height-fill .image-block__image {
        height: 100%;
      }


      .image-block__image {
        width: 100%;
        height: auto;
        object-fit: cover;
        aspect-ratio: var(--ratio);
      }




      @media (max-width: 749px) {
      .image-block,
      .image-block__image,
      .placeholder-image {
        aspect-ratio: var(--ratio-mobile, var(--ratio));
      }


      .placeholder-image img {
        aspect-ratio: var(--ratio-mobile, var(--ratio));
      }
    }
{% endstylesheet %}


{% schema %}
{
  "name": "t:names.image",
  "tag": null,
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:settings.image"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:settings.link"
    },
    {
      "type": "header",
      "content": "t:content.size"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "options": [
        {
          "value": "adapt",
          "label": "t:options.auto"
        },
        {
          "value": "portrait",
          "label": "t:options.portrait"
        },
        {
          "value": "square",
          "label": "t:options.square"
        },
        {
          "value": "landscape",
          "label": "t:options.landscape"
        }
      ],
      "default": "adapt",
      "label": "t:settings.aspect_ratio"
    },
    {
      "type": "checkbox",
      "id": "use_mobile_ratio",
      "label": "Different aspect ratio in mobile",
      "default": false
    },
    {
      "type": "select",
      "id": "image_ratio_mobile",
      "label": "Aspect ratio (mobile)",
      "options": [
        { "value": "adapt", "label": "t:options.auto" },
        { "value": "portrait", "label": "t:options.portrait" },
        { "value": "square", "label": "t:options.square" },
        { "value": "landscape", "label": "t:options.landscape" }
      ],
      "default": "adapt",
      "visible_if": "{{ block.settings.use_mobile_ratio }}"
    },
    {
      "type": "select",
      "id": "width",
      "label": "t:settings.width_desktop",
      "options": [
        {
          "value": "fit-content",
          "label": "t:options.fit_content"
        },
        {
          "value": "fill",
          "label": "t:options.fill"
        },
        {
          "value": "custom",
          "label": "t:options.custom"
        }
      ],
      "default": "fill"
    },
    {
      "type": "range",
      "id": "custom_width",
      "label": "t:settings.custom_width",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.width == 'custom' }}"
    },
    {
      "type": "select",
      "id": "width_mobile",
      "label": "t:settings.width_mobile",
      "options": [
        {
          "value": "fit-content",
          "label": "t:options.fit_content"
        },
        {
          "value": "fill",
          "label": "t:options.fill"
        },
        {
          "value": "custom",
          "label": "t:options.custom"
        }
      ],
      "default": "fill"
    },
    {
      "type": "range",
      "id": "custom_width_mobile",
      "label": "t:settings.custom_width",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.width_mobile == 'custom' }}"
    },
    {
      "type": "select",
      "id": "height",
      "label": "t:settings.height",
      "options": [
        {
          "value": "fit",
          "label": "t:options.fit_content"
        },
        {
          "value": "fill",
          "label": "t:options.fill"
        }
      ],
      "default": "fit",
      "visible_if": "{{ block.settings.image_ratio == 'adapt' }}"
    },
    {
      "type": "header",
      "content": "t:content.borders"
    },
    {
      "type": "select",
      "id": "border",
      "label": "t:settings.style",
      "options": [
        {
          "value": "none",
          "label": "t:options.none"
        },
        {
          "value": "solid",
          "label": "t:options.solid"
        }
      ],
      "default": "none"
    },
    {
      "type": "range",
      "id": "border_width",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "t:settings.thickness",
      "default": 1,
      "visible_if": "{{ block.settings.border != 'none' }}"
    },
    {
      "type": "range",
      "id": "border_opacity",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "label": "t:settings.opacity",
      "default": 100,
      "visible_if": "{{ block.settings.border != 'none' }}"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "t:settings.border_radius",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "Performance"
    },
    {
      "type": "checkbox",
      "id": "lazy",
      "label": "Lazy loading",
      "default": true
    },


    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "t:names.image",
      "category": "t:categories.basic"
    }
  ]
}
{% endschema %}


